{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akeyless.io/helm-charts/akeyless-zero-trust-web-access/values.schema.json",
  "title": "Akeyless Zero Trust Web Access Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ztwaAuth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "ztwaAccessType": {
              "type": "string",
              "enum": ["", "access_key", "aws_iam", "azure_ad", "gcp"],
              "description": "Auth method type of ztwaAccessID. Empty string (default) auto detects: access_key when ztwaExistingSecret is set, else the cloud identity found from IMDS. The dispatcher uses a cloud type when its IMDS probe cannot find the cloud, for clusters where the pod cannot reach 169.254.169.254."
            },
            "authorizedAccessIDs": {
              "type": "array",
              "items": { "type": ["string", "integer"], "minLength": 1 },
              "description": "Access IDs of the users that can open ZTWA sessions."
            }
          }
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": { "type": ["object", "string"] }
    },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "title": "Global image and registry pull settings",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "description": "List of { name: secretName } for every pod. Merged with per-workload imagePullSecrets and, when set, the chart-generated docker secret (deduplicated).",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "dockerRepositoryCreds": {
          "type": ["string", "null"],
          "deprecated": true,
          "description": "Deprecated. Base64 dockerconfig used only to create the pre-install pull secret. Prefer a kubernetes.io/dockerconfigjson secret you create and set image.imagePullSecrets; this field will be removed in a future version."
        }
      }
    },
    "dispatcher": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "initContainer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "description": "Merged on the dispatcher pod with image.imagePullSecrets and dispatcher.image.imagePullSecrets; deduplicated at pod spec.",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        }
      }
    },
    "webWorker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "initContainer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        }
      }
    },
    "webProxy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "initContainer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer" }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "parentGateway": { "type": "string" },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
              }
            }
          }
        }
      }
    }
  }
}
