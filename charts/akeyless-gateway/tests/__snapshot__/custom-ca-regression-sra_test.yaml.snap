          - mountPath: /etc/ssl/certs/ca-certificates.crt
            name: ca-certificates
            subPath: ca-certificates.crt
    securityContext:
      runAsGroup: 0
      runAsUser: 0
    serviceAccountName: default
    volumes:
      - emptyDir: {}
        name: config
      - emptyDir: {}
        name: creds
      - name: gw-signed-ca
        secret:
          items:
            - key: tlsCertificate
              path: gw-cert.pem
          secretName: gw-tls
      - configMap:
          name: corp-ca
        name: ca-certificates
      - configMap:
          name: RELEASE-NAME-cm-creds
        name: configmap-creds
