sra.customCA and gateway.customCA both replace:
  1: |
    containers:
      - env:
          - name: GATEWAY_ACCESS_TYPE
            value: null
          - name: UNIFIED_GATEWAY
            value: "true"
          - name: GATEWAY_URL
            value: http://RELEASE-NAME-akeyless-gateway.NAMESPACE.svc.cluster.local:8000
          - name: INTERNAL_GATEWAY_API
            value: http://RELEASE-NAME-akeyless-gateway-internal.NAMESPACE.svc.cluster.local:8080
          - name: REMOTE_ACCESS_SSH_SERVICE_INTERNAL_URL
            value: http://ssh-RELEASE-NAME-akeyless-gateway-internal.NAMESPACE.svc.cluster.local:9900
          - name: REMOTE_ACCESS_SSH_ENDPOINT
            value: ssh-RELEASE-NAME-akeyless-gateway.NAMESPACE.svc.cluster.local:22
          - name: USE_CLUSTER_CACHE
            value: "true"
          - name: REDIS_ADDR
            value: RELEASE-NAME-akeyless-gateway-cache-svc.NAMESPACE.svc:6379
          - name: ENABLE_CACHE_TLS
            value: "false"
          - name: STORE_CACHE_ENCRYPTION_KEY_TO_K8S_SECRETS
            value: "false"
          - name: REDIS_PASS
            valueFrom:
              secretKeyRef:
                key: cache-pass
                name: RELEASE-NAME-cache-secret
          - name: REMOTE_ACCESS_TYPE
            value: web
          - name: chart_name
            value: akeyless-gateway
          - name: chart_version
            value: 0.0.0-regression
        image: akeyless/zero-trust-bastion:3.7.0
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 10
          initialDelaySeconds: 15
          periodSeconds: 30
          tcpSocket:
            port: 8888
        name: gateway-sra-web
        ports:
          - containerPort: 8888
            name: web
        readinessProbe:
          initialDelaySeconds: 15
          periodSeconds: 30
          tcpSocket:
            port: 8888
          timeoutSeconds: 5
        resources:
          requests:
            cpu: 1
            memory: 2G
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: false
          runAsGroup: 1001
          runAsNonRoot: true
          runAsUser: 1001
        volumeMounts:
          - mountPath: /etc/ssl/certs/ca-certificates.crt
            name: ca-certificates
            subPath: ca-certificates.crt
    securityContext:
      fsGroup: 1001
      runAsGroup: 1001
      runAsNonRoot: true
      runAsUser: 1001
      seccompProfile:
        type: RuntimeDefault
    serviceAccountName: default
    volumes:
      - configMap:
          name: corp-ca
        name: ca-certificates
  2: |
    containers:
      - env:
          - name: SSH_PROXY_PORT
            value: "2200"
          - name: EXTERNAL_SSH_PORT
            value: "22"
          - name: GATEWAY_ACCESS_TYPE
            value: null
          - name: UNIFIED_GATEWAY
            value: "true"
          - name: GATEWAY_URL
            value: http://RELEASE-NAME-akeyless-gateway.NAMESPACE.svc.cluster.local:8000
          - name: INTERNAL_GATEWAY_API
            value: http://RELEASE-NAME-akeyless-gateway-internal.NAMESPACE.svc.cluster.local:8080
          - name: USE_CLUSTER_CACHE
            value: "true"
          - name: REDIS_ADDR
            value: RELEASE-NAME-akeyless-gateway-cache-svc.NAMESPACE.svc:6379
          - name: ENABLE_CACHE_TLS
            value: "false"
          - name: STORE_CACHE_ENCRYPTION_KEY_TO_K8S_SECRETS
            value: "false"
          - name: REDIS_PASS
            valueFrom:
              secretKeyRef:
                key: cache-pass
                name: RELEASE-NAME-cache-secret
          - name: REMOTE_ACCESS_TYPE
            value: ssh-proxy
          - name: VERSION
            value: 3.7.0
          - name: chart_name
            value: akeyless-gateway
          - name: chart_version
            value: 0.0.0-regression
        image: akeyless/zero-trust-bastion:3.7.0
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 5
          httpGet:
            path: /status
            port: 9900
          periodSeconds: 30
          timeoutSeconds: 5
        name: gateway-sra-ssh
        ports:
          - containerPort: 2200
            name: ssh
          - containerPort: 9900
            name: curl-proxy
        readinessProbe:
          httpGet:
            path: /status
            port: 9900
          initialDelaySeconds: 20
          periodSeconds: 10
          timeoutSeconds: 5
        resources:
          requests:
            cpu: 1
            memory: 2G
        securityContext:
          allowPrivilegeEscalation: true
          appArmorProfile:
            type: Unconfined
          capabilities:
            add:
              - SYS_CHROOT
              - AUDIT_WRITE
              - SYS_ADMIN
              - MKNOD
              - DAC_OVERRIDE
              - CHOWN
              - SETUID
              - SETGID
              - FOWNER
              - KILL
            drop:
              - ALL
        volumeMounts:
          - mountPath: /var/akeyless/conf
            name: config
          - mountPath: /var/akeyless/creds
            name: configmap-creds
          - mountPath: /etc/ssl/certs/ca-certificates.crt
            name: ca-certificates
            subPath: ca-certificates.crt
    securityContext:
      runAsGroup: 0
      runAsUser: 0
    serviceAccountName: default
    volumes:
      - emptyDir: {}
        name: config
      - emptyDir: {}
        name: creds
      - configMap:
          name: corp-ca
        name: ca-certificates
      - configMap:
          name: RELEASE-NAME-cm-creds
        name: configmap-creds
