customCA off, TLS, metrics, image override and extra volumes:
  1: |
    containers:
      - env:
          - name: ARTIFACTS_REPO
            value: artifacts.site2.akeyless.io
          - name: GATEWAY_ACCESS_TYPE
            value: access_key
          - name: GATEWAY_ACCESS_ID
            valueFrom:
              secretKeyRef:
                key: gateway-access-id
                name: RELEASE-NAME-conf-secret
          - name: GATEWAY_ACCESS_KEY
            valueFrom:
              secretKeyRef:
                key: gateway-access-key
                name: gw-creds
          - name: GATEWAY_CLUSTER_CACHE
            value: enable
          - name: USE_CLUSTER_CACHE
            value: "true"
          - name: REDIS_ADDR
            value: RELEASE-NAME-akeyless-gateway-cache-svc.NAMESPACE.svc:6379
          - name: ENABLE_CACHE_TLS
            value: "false"
          - name: STORE_CACHE_ENCRYPTION_KEY_TO_K8S_SECRETS
            value: "false"
          - name: REDIS_PASS
            valueFrom:
              secretKeyRef:
                key: cache-pass
                name: RELEASE-NAME-cache-secret
          - name: ENABLE_METRICS
            value: "true"
          - name: MEM_LIMIT
            valueFrom:
              resourceFieldRef:
                containerName: akeyless-gateway
                resource: limits.memory
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: UNIFIED_GATEWAY
            value: "true"
          - name: MIN_TLS_VERSION
            value: TLSv1.2
          - name: VERSION
            value: 5.6.0
          - name: chart_name
            value: akeyless-gateway
          - name: chart_version
            value: 0.0.0-regression
        image: registry.example.com/gateway:9.9.9
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 10
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 60
          periodSeconds: 30
        name: akeyless-gateway
        ports:
          - containerPort: 8000
            name: gateway
          - containerPort: 8080
            name: internal-gw-api
        readinessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 60
          periodSeconds: 10
          timeoutSeconds: 5
        resources: {}
        volumeMounts:
          - mountPath: /home/akeyless/.akeyless
            name: akeyless-config
          - mountPath: /akeyless/otel-config.yaml
            name: otelcol-metrics-config
            subPath: otel-config.yaml
          - mountPath: /home/akeyless/.akeyless/akeyless-api-cert.crt
            name: tls-conf-cert
            readOnly: true
            subPath: akeyless-api-cert.crt
          - mountPath: /home/akeyless/.akeyless/akeyless-api-cert.key
            name: tls-conf-private-key
            readOnly: true
            subPath: akeyless-api-cert.key
          - mountPath: /extra
            name: extra
    serviceAccountName: default
    volumes:
      - emptyDir: {}
        name: akeyless-config
      - name: tls-conf-cert
        secret:
          defaultMode: 420
          items:
            - key: tlsCertificate
              path: akeyless-api-cert.crt
          secretName: gw-tls
      - name: tls-conf-private-key
        secret:
          defaultMode: 420
          items:
            - key: tlsPrivateKey
              path: akeyless-api-cert.key
          secretName: gw-tls
      - name: otelcol-metrics-config
        secret:
          secretName: gw-metrics
      - emptyDir: {}
        name: extra
