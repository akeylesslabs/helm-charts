        resources:
          limits:
            cpu: "2"
            memory: 4G
          requests:
            cpu: "1"
            memory: 2G
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
              - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 1001
          runAsNonRoot: true
          runAsUser: 1001
        volumeMounts:
          - mountPath: /home/akeyless/.akeyless
            name: akeyless-config
          - mountPath: /usr/local/share/ca-certificates
            name: usr-local-ca-certificates
          - mountPath: /etc/ssl/certs
            name: etc-ssl-certs
          - mountPath: /etc/ssl/certs/ca-certificates.crt
            name: ca-certificates
            subPath: ca-certificates.crt
          - mountPath: /tmp
            name: tmp
          - mountPath: /run
            name: run
          - mountPath: /akeyless/tmp
            name: akeyless-tmp
          - mountPath: /akeyless/bin
            name: akeyless-bin
          - mountPath: /var/run/akeyless
            name: var-run-akeyless
          - mountPath: /var/log/akeyless
            name: var-log-akeyless
          - mountPath: /var/log/supervisor
            name: var-log-supervisor
          - mountPath: /var/akeyless/conf
            name: var-akeyless-conf
          - mountPath: /app
            name: app
          - mountPath: /download_center
            name: download-center
    securityContext:
      fsGroup: 1001
      runAsGroup: 1001
      runAsNonRoot: true
      runAsUser: 1001
      seccompProfile:
        type: RuntimeDefault
    serviceAccountName: default
    volumes:
      - emptyDir: {}
        name: akeyless-config
      - configMap:
          name: corp-ca
        name: ca-certificates
      - emptyDir: {}
        name: tmp
      - emptyDir: {}
        name: run
      - emptyDir: {}
        name: akeyless-tmp
      - emptyDir: {}
        name: akeyless-bin
      - emptyDir: {}
        name: var-run-akeyless
      - emptyDir: {}
        name: var-log-akeyless
      - emptyDir: {}
        name: var-log-supervisor
      - emptyDir: {}
        name: var-akeyless-conf
      - emptyDir: {}
        name: app
      - emptyDir: {}
        name: download-center
      - emptyDir: {}
        name: usr-local-ca-certificates
      - emptyDir: {}
        name: etc-ssl-certs
