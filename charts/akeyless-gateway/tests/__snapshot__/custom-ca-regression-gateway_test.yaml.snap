            value: "false"
          - name: REDIS_PASS
            valueFrom:
              secretKeyRef:
                key: cache-pass
                name: RELEASE-NAME-cache-secret
          - name: POD_NAME
            valueFrom:
              fieldRef:
                fieldPath: metadata.name
          - name: UNIFIED_GATEWAY
            value: "true"
          - name: MIN_TLS_VERSION
            value: TLSv1.2
          - name: VERSION
            value: 5.6.0
          - name: chart_name
            value: akeyless-gateway
